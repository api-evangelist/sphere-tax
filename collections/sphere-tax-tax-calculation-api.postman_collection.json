      "item": [
        {
          "id": "0e21f0e1-0a9e-4368-890c-2622b12e3e27",
          "name": "Calculate tax for a transaction.",
          "request": {
            "name": "Calculate tax for a transaction.",
            "description": {
              "content": "Calculates indirect tax (sales tax, VAT, GST) for one or more line items against a customer address and currency. Returns per-line tax amounts, taxable amounts, a tax rate breakdown (percentage, jurisdiction, country, state, tax type), and a unique calculation id.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "tax_api",
                "calculate_tax"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_address\": {\n    \"country\": \"<string>\",\n    \"address1\": \"<string>\",\n    \"address2\": \"<string>\",\n    \"city\": \"<string>\",\n    \"state\": \"<string>\",\n    \"postal_code\": \"<string>\"\n  },\n  \"line_items\": [\n    {\n      \"amount\": \"<integer>\",\n      \"id\": \"<string>\",\n      \"product_id\": \"<string>\",\n      \"discount_amount\": \"<integer>\",\n      \"tax_inclusive\": \"<boolean>\"\n    },\n    {\n      \"amount\": \"<integer>\",\n      \"id\": \"<string>\",\n      \"product_id\": \"<string>\",\n      \"discount_amount\": \"<integer>\",\n      \"tax_inclusive\": \"<boolean>\"\n    }\n  ],\n  \"currency\": \"<string>\",\n  \"customer_id\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "e319f81b-3dfb-4b13-8541-2bee837ce52a",
              "name": "Tax calculated successfully.",
              "originalRequest": {
                "url": {
                  "path": [
                    "tax_api",
                    "calculate_tax"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
